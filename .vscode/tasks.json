{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Diff (Debug)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/build.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
